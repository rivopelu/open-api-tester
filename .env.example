# Supabase project URL - found under Settings > API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase anon/public key - safe to expose in client-side code
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Google OAuth web client (the client ID is public; the secret is backend-only)
VITE_GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
# Set explicitly when a development proxy or reverse proxy changes the request host.
GOOGLE_REDIRECT_URI=http://localhost:8888/api/auth/google/callback
ALLOWED_EMAIL_DOMAINS=example.com,example.org

# Database connection string - used only by migration scripts
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# OLD Supabase project Postgres (postgres role) — source for `pnpm migrate:data`
SUPABASE_DATABASE_URL=postgresql://postgres.<old-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Backend
# Add these backend values to the Vercel project's Environment Variables.
PORT=8888
APP_ENV=dev
APP_NAME=modern-api-studio
API_PREFIX=/api
LOG_LEVEL=debug
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=modern_api_studio
DB_SSL=false
JWT_SECRET=change-this-to-a-random-secret
BCRYPT_ROUNDS=10
JWT_ISSUER=modern-api-studio
ALLOWED_ORIGINS=http://localhost:5173
